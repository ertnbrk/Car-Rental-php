# Application
APP_NAME="Car Rental"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=https://your-domain.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

# Application Ports (Docker)
APP_PORT=8080
PMA_PORT=8081

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=car_rental
DB_USERNAME=laravel
DB_PASSWORD=your_password
DB_ROOT_PASSWORD=your_root_password

# Cache & Session
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue
QUEUE_CONNECTION=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (for S3 storage if needed)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# FX Rate Configuration
FX_TCMB_URL=https://www.tcmb.gov.tr/kurlar/today.xml
FX_CACHE_TTL=3600
FX_BASE_CURRENCY=TRY

# Offers Configuration
OFFERS_NTH=5
OFFERS_PERCENT=10

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Vite (Frontend Build)
VITE_APP_NAME="${APP_NAME}"

# Security Headers
# Add these in your web server config or middleware
# X-Frame-Options: SAMEORIGIN
# X-Content-Type-Options: nosniff
# X-XSS-Protection: 1; mode=block
# Strict-Transport-Security: max-age=31536000; includeSubDomains

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload Limits
MAX_UPLOAD_SIZE=20480  # in KB (20MB)

# Pagination
PAGINATION_PER_PAGE=12

# Admin Configuration
ADMIN_EMAIL=admin@your-domain.com

# Backup Configuration (if using spatie/laravel-backup)
BACKUP_ARCHIVE_PASSWORD=

# Sentry (Error Tracking - Optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Google Analytics (Optional)
GOOGLE_ANALYTICS_ID=

# reCAPTCHA (Optional - for forms)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
